# We accept the following hadolint issues because this is a build container.
#
# hadolint global ignore=DL3002,DL3003,DL3008,DL3009,DL3013,DL3059,DL4006

# cspell: disable

FROM docker.io/ubuntu:26.10
USER root

# -----------------------------------------------
# ----  Environment  ----------------------------
# -----------------------------------------------

WORKDIR /src

ENV __INSTALLATION_PREFIX=/usr/local
ENV __TOOLCHAIN_VERSION_GO=1.27.2
ENV __TOOLCHAIN_VERSION_MESON=1.12.1
ENV __TOOLCHAIN_VERSION_RUST=1.99.0
ENV __TOOLCHAIN_VERSION_MOLD=3.0.0

ENV CARGO_HOME=/root/.cache/rust/${__TOOLCHAIN_VERSION_RUST}/cargo/home
ENV RUSTUP_HOME=/root/.cache/rust/${__TOOLCHAIN_VERSION_RUST}/rustup/home

ENV DEBIAN_FRONTEND=noninteractive
ENV LD_LIBRARY_PATH=/usr/local/lib/x86_64-linux-gnu
ENV PATH=${CARGO_HOME}/bin:/root/.local/bin:/usr/go/bin:$PATH

RUN ln --symbolic --force --no-dereference "$(command -v bash)" "$(command -v sh)"

# -----------------------------------------------
# ----  Installation of General Packages  -------
# -----------------------------------------------

COPY commands/__apt_get commands/__apt_install commands/__log /root/.local/bin/

RUN __apt_get update \
    && __apt_get dist-upgrade \
    && __apt_install \
        bash-completion \
        ca-certificates \
        curl \
        file \
        openssl \
        tar \
        wget \
        xz-utils \
        \
        bison \
        build-essential \
        clang \
        cmake \
        flex \
        gcc \
        gettext \
        git \
        gnupg2 \
        nasm \
        ninja-build \
        pkg-config \
        scdoc \
        \
        lua5.5 \
        liblua5.5-0 \
        liblua5.5-dev \
        \
        python3 \
        python3-docutils \
        python3-setuptools \
        python3-dev \
        \
        dbus \
        libdrm-dev \
        libffi-dev \
        liblz4-dev \
        libpam0g-dev \
        libpcre2-dev \
        librsvg2-dev \
        libseccomp-dev \
        libssl-dev \
        libudev-dev \
        shared-mime-info \
        \
        systemd \
        systemd-dev \
        libsystemd-dev \
    && __apt_get autoremove --purge

# -----------------------------------------------
# ----  Copy Build Scripts (Except Custom)  -----
# -----------------------------------------------

COPY commands/__build commands/__git_clone /root/.local/bin/

# -----------------------------------------------
# ----  Toolchain Setup  ------------------------
# -----------------------------------------------

RUN __log "Setting up UV (Python)"                                                   \
    && curl -sSfL https://astral.sh/uv/install.sh | sh                               \
    && uv tool install "meson==${__TOOLCHAIN_VERSION_MESON}"                         \
    \
    && __log "Setting up Rust"                                                       \
    && { [ -d "${CARGO_HOME}" ] || curl -sSfL https://sh.rustup.rs                   \
        | sh -s -- -y --default-toolchain "${__TOOLCHAIN_VERSION_RUST}" ; }          \
    && rustup toolchain install "${__TOOLCHAIN_VERSION_RUST}"                        \
    \
    && __log "Setting up Go"                                                         \
    && mkdir -p "/root/.cache/go/${__TOOLCHAIN_VERSION_GO}"                          \
    && { [ -e "/root/.cache/go/${__TOOLCHAIN_VERSION_GO}/go.tar.gz" ] ||             \
        curl -sSfL -o "/root/.cache/go/${__TOOLCHAIN_VERSION_GO}/go.tar.gz"          \
            "https://go.dev/dl/go${__TOOLCHAIN_VERSION_GO}.linux-amd64.tar.gz" ; }   \
    && tar xf "/root/.cache/go/${__TOOLCHAIN_VERSION_GO}/go.tar.gz" -C /usr          \
    \
    && __log "Setting up mold"                                                       \
    && mkdir -p "/root/.cache/mold"                                                  \
    && MOLD_TARBALL="mold-${__TOOLCHAIN_VERSION_MOLD}-x86_64-linux.tar.gz"           \
    && { [ -e "/root/.cache/mold/${MOLD_TARBALL}" ] ||                               \
        curl -sSfL -o "/root/.cache/mold/${MOLD_TARBALL}"                            \
            "https://github.com/rui314/mold/releases/download/v${__TOOLCHAIN_VERSION_MOLD}/${MOLD_TARBALL}" ; } \
    && tar xf "/root/.cache/mold/${MOLD_TARBALL}" -C /usr/ --strip-components=1      \
    && ln -snf "$(command -v mold)" "$(command -v ld)"                               \
    && mkdir -p /.cargo                                                              \
    && echo "[target.'cfg(target_os = \"linux\")']"            >>/.cargo/config.toml \
    && echo "rustflags = [\"-C\", \"link-arg=-fuse-ld=mold\"]" >>/.cargo/config.toml \
    \
    && __log "Setting up git"                                                        \
    && git config --global advice.detachedHead false

# -----------------------------------------------
# ----  Actual Build  ---------------------------
# -----------------------------------------------

# ? Wayland

RUN __git_clone https://gitlab.freedesktop.org/wayland/wayland.git 1.26.0 \
    && __git_clone https://gitlab.freedesktop.org/wayland/wayland-protocols.git 1.49

RUN __build wayland meson_ninja              \
        -D libraries=true                    \
        -D scanner=true                      \
        -D tests=false                       \
        -D documentation=false               \
        -D dtd_validation=false              \
    && __build wayland-protocols meson_ninja \
        -D tests=false

# ? Generic Dependencies

RUN __git_clone https://gitlab.freedesktop.org/libinput/libinput.git 1.32.0 \
    && __git_clone https://gitlab.freedesktop.org/pixman/pixman.git pixman-0.46.4

RUN __apt_install libevdev-dev libmtdev-dev

RUN __build libinput meson_ninja  \
        -D libwacom=false         \
        -D mtdev=false            \
        -D debug-gui=false        \
        -D tests=false            \
        -D documentation=false    \
    && __build pixman meson_ninja \
        -D tests=disabled         \
        -D demos=disabled

# ? X11

RUN __git_clone https://gitlab.freedesktop.org/xorg/proto/xorgproto.git xorgproto-2026.1 \
    && __git_clone https://gitlab.freedesktop.org/xorg/xserver.git xwayland-26.0.99.903

RUN __apt_install          \
        libaudit-dev       \
        libbsd-dev         \
        libepoxy-dev       \
        libdecor-0-dev     \
        libei-dev          \
        libegl-dev         \
        libgl-dev          \
        libgbm-dev         \
        liboeffis-dev      \
        libx11-dev         \
        libxcb-damage0-dev \
        libxcb-dri3-dev    \
        libxcb-sync-dev    \
        libxcb-xinput-dev  \
        libxcvt-dev        \
        libxfont-dev       \
        libxkbfile-dev     \
        libxshmfence-dev   \
        mesa-common-dev    \
        x11-xkb-utils      \
        xfonts-utils       \
        xutils-dev

RUN __build xorgproto meson_ninja  \
    && __build xserver meson_ninja \
        -D docs=false              \
        -D glamor=true             \
        -D dri3=true               \
        -D drm=true                \
        -D glx=true

# ? SwayFX

RUN __git_clone https://gitlab.freedesktop.org/wlroots/wlroots.git 0.20.2
RUN __apt_install               \
        libxkbcommon-dev        \
        libgles-dev             \
        libvulkan-dev           \
        glslang-dev             \
        glslang-tools           \
        libseat-dev             \
        hwdata                  \
        libdisplay-info-dev     \
        libliftoff-dev          \
        libxcb-present-dev      \
        libxcb-render-util0-dev \
        libxcb-composite0-dev   \
        libxcb-ewmh-dev         \
        libxcb-icccm4-dev       \
        libxcb-res0-dev         \
        libxcb-errors-dev
RUN __build wlroots meson_ninja      \
        -D xwayland=enabled          \
        -D examples=false            \
        -D renderers=gles2,vulkan    \
        -D backends=drm,libinput,x11 \
        -D session=enabled           \
        -D color-management=enabled  \
        -D libliftoff=enabled

RUN __git_clone https://github.com/wlrfx/scenefx.git \
    __ref ac7a11ca03cdb66c284d988e6f587b401bd400e5
RUN __build scenefx meson_ninja \
        -D examples=false       \
        -D color-management=enabled

RUN __git_clone https://github.com/WillPower3309/swayfx.git \
    __ref 2caa04a5f42a5cec5e72e04aee819b7662405fb7
RUN __apt_install libjson-c-dev
RUN __build swayfx meson_ninja        \
        -D default-wallpaper=false    \
        -D zsh-completions=false      \
        -D bash-completions=true      \
        -D fish-completions=false     \
        -D swaybar=false              \
        -D swaynag=false              \
        -D tray=enabled               \
        -D gdk-pixbuf=enabled         \
        -D man-pages=enabled          \
        -D sd-bus-provider=libsystemd

# ? xdg-desktop-portal(s)

RUN __git_clone https://gitlab.gnome.org/GNOME/libdex.git \
    __ref 6561725344d18b954c1c3a703c92d856edeed103
RUN __apt_install liburing-dev libgirepository1.0-dev
RUN __build libdex meson_ninja    \
        -D stack-protector=true   \
        -D vapi=false             \
        -D introspection=enabled  \
        -D liburing=enabled       \
        -D eventfd=enabled        \
        -D gdbus=enabled

RUN __git_clone https://github.com/flatpak/xdg-desktop-portal.git \
    __ref ee298d1817fed18c208c9ddb638a4aef7bcecc9b
RUN __apt_install                        \
        libflatpak-dev                   \
        libjson-glib-dev                 \
        libfuse3-dev                     \
        libgstreamer1.0-dev              \
        libgstreamer-plugins-base1.0-dev \
        libgeoclue-2-dev                 \
        libpipewire-0.3-dev              \
        libpipewire-0.3-modules          \
        libdbus-1-dev                    \
        libwireplumber-0.5-dev
RUN __build xdg-desktop-portal meson_ninja    \
        -D flatpak-interfaces=enabled         \
        -D geoclue=enabled                    \
        -D gudev=enabled                      \
        -D systemd=enabled                    \
        -D documentation=disabled             \
        -D tests=disabled                     \
        -D man-pages=enabled                  \
        -D sandboxed-image-validation=enabled \
        -D sandboxed-sound-validation=enabled

RUN __git_clone https://github.com/emersion/xdg-desktop-portal-wlr.git \
    __ref c0255d7b047b7263629ab5a314661045ff7f65e3
RUN __apt_install libinih-dev
RUN __build xdg-desktop-portal-wlr meson_ninja \
        -Dsd-bus-provider=libsystemd         \
        -Dsystemd=enabled                    \
        -Dman-pages=enabled

# ? Associates

# * 0. Dependencies & cloning

RUN __apt_install libjpeg-dev libjxl-dev libadwaita-1-dev libgtk-4-dev valac

RUN __git_clone https://github.com/wmww/gtk4-layer-shell.git \
    __ref 69ad9a02a8c31ac2d3db6710f43b3d8434559e46
RUN __build gtk4-layer-shell meson_ninja \
        -D examples=false                \
        -D docs=false                    \
        -D tests=false                   \
        -D smoke-tests=false             \
        -D introspection=true            \
        -D vapi=true

# TODO remove once ironbar patches are upstreamed
RUN git -C ironbar reset --hard || :

RUN __git_clone https://github.com/davatorium/rofi.git next                              \
    && __git_clone https://gitlab.freedesktop.org/emersion/grim.git master               \
    && __git_clone https://github.com/emersion/slurp.git master                          \
    && __git_clone https://github.com/swaywm/swaybg.git master                           \
    && __git_clone https://github.com/swaywm/swayidle.git master                         \
    && __git_clone https://github.com/swaywm/swaylock.git master                         \
    && __git_clone https://github.com/kennylevinsen/wlsunset.git master                  \
    && __git_clone https://github.com/ErikReider/SwayNotificationCenter.git main         \
    && __git_clone https://codeberg.org/tytan652/door-knocker.git main                   \
    \
    && __git_clone https://github.com/alacritty/alacritty.git v0.17.0                    \
    && __git_clone https://github.com/JakeStanger/ironbar.git master                     \
    && __git_clone https://codeberg.org/LGFae/awww.git main                              \
    && __git_clone https://github.com/zefr0x/ianny.git main                              \
    && __git_clone https://github.com/blurrycat/lightctl.git main                        \
    && __git_clone https://github.com/Satty-org/Satty.git main                           \
    && __git_clone https://gitlab.com/w0lff/shikane.git master                           \
    && __git_clone https://github.com/rafaelrc7/wayland-pipewire-idle-inhibit.git master \
    && __git_clone https://github.com/russelltg/wl-screenrec.git main                    \
    && __git_clone https://github.com/AMNatty/wleave.git main

# * 1. Default builds

RUN __apt_install pandoc doxygen
RUN __build rofi meson_ninja \
        -D drun=true         \
        -D window=true       \
        -D check=disabled    \
        -D imdkit=false      \
        -D xcb=disabled      \
        -D wayland=enabled

RUN __apt_install libjpeg-dev
RUN __build grim meson_ninja \
        -D jpeg=enabled      \
        -D man-pages=enabled \
        -D bash-completions=true

RUN __build slurp meson_ninja

RUN __build swaybg meson_ninja \
        -D gdk-pixbuf=enabled  \
        -D man-pages=enabled

RUN __build swayidle meson_ninja   \
        -D man-pages=enabled       \
        -D logind=enabled          \
        -D logind-provider=systemd \
        -D zsh-completions=false   \
        -D bash-completions=true   \
        -D fish-completions=false

RUN __apt_install libcrypt-dev
RUN __build swaylock meson_ninja \
        -D pam=enabled           \
        -D gdk-pixbuf=enabled    \
        -D man-pages=enabled     \
        -D zsh-completions=false \
        -D bash-completions=true \
        -D fish-completions=false

RUN __build wlsunset meson_ninja

RUN __apt_install sassc blueprint-compiler libgranite-7-dev libpulse-dev
RUN __build SwayNotificationCenter meson_ninja \
        -D systemd-service=false               \
        -D scripting=false                     \
        -D pulse-audio=true                    \
        -D man-pages=true                      \
        -D systemd-service=false               \
        -D zsh-completions=false               \
        -D fish-completions=false

RUN __apt_install desktop-file-utils
RUN __build door-knocker meson_ninja

# * 3. Custom builds

RUN cd alacritty                                                                     \
    && cargo build --release --no-default-features --features=wayland                \
    && install -s -Dm755 target/release/alacritty -t "${__INSTALLATION_PREFIX}/bin/" \
    && scdoc < extra/man/alacritty.1.scd                                             \
      | gzip -c >"${__INSTALLATION_PREFIX}/share/man/man1/alacritty.1.gz"            \
    && scdoc < extra/man/alacritty-msg.1.scd                                         \
      | gzip -c >"${__INSTALLATION_PREFIX}/share/man/man1/alacritty-msg.1.gz"        \
    && scdoc < extra/man/alacritty.5.scd                                             \
      | gzip -c >"${__INSTALLATION_PREFIX}/share/man/man5/alacritty.5.gz"            \
    && scdoc < extra/man/alacritty-bindings.5.scd                                    \
      | gzip -c >"${__INSTALLATION_PREFIX}/share/man/man5/alacritty-bindings.5.gz"

# TODO remove patches once all are upstream and pin the version with a long ref afterward
RUN __apt_install libluajit-5.1-dev
RUN git -C ironbar reset --hard
COPY patches/ironbar.patch /tmp/
RUN git -C ironbar apply /tmp/ironbar.patch
RUN cd ironbar               \
    && cargo build --release \
    && install -s -Dm755 target/release/ironbar -t "${__INSTALLATION_PREFIX}/bin/"

RUN cd awww \
    && cargo build --release \
    && install -s -Dm755 target/release/awww        -t "${__INSTALLATION_PREFIX}/bin/"   \
    && install -s -Dm755 target/release/awww-daemon -t "${__INSTALLATION_PREFIX}/bin/"   \
    && install    -Dm644 completions/awww.bash                                           \
        -t "${__INSTALLATION_PREFIX}/share/bash-completion/completions/"                 \
    && sh ./doc/gen.sh                                                                   \
    && for MAN_PAGE_FILE in doc/generated/*; do                                          \
        install -Dm644 "${MAN_PAGE_FILE}" -t "${__INSTALLATION_PREFIX}/share/man/man1/"; \
    done

RUN cd ianny \
    && cargo build --release \
    && install -s -Dm755 target/release/ianny -t "${__INSTALLATION_PREFIX}/bin/"

RUN cd lightctl \
    && cargo build --release \
    && install -s -Dm755 target/release/lightctl -t "${__INSTALLATION_PREFIX}/bin/"

RUN cd Satty                                                                                            \
    && cargo build --release                                                                            \
    && install -s -Dm755 target/release/satty -t "${__INSTALLATION_PREFIX}/bin/"                        \
    && install -Dm644 assets/satty.svg -t "${__INSTALLATION_PREFIX}/share/icons/hicolor/scalable/apps/" \
    && install -Dm644 satty.desktop    -t "${__INSTALLATION_PREFIX}/share/applications/"

RUN cd shikane                                                                        \
    && cargo build --release                                                          \
    && install -s -Dm755 target/release/shikane    -t "${__INSTALLATION_PREFIX}/bin/" \
    && install -s -Dm755 target/release/shikanectl -t "${__INSTALLATION_PREFIX}/bin/"

RUN cd wayland-pipewire-idle-inhibit \
    && cargo build --release         \
    && install -s -Dm755 target/release/wayland-pipewire-idle-inhibit -t "${__INSTALLATION_PREFIX}/bin/"

RUN __apt_install libavutil-dev libavformat-dev libavfilter-dev libavdevice-dev
RUN cd wl-screenrec          \
    && cargo build --release \
    && install -s -Dm755 target/release/wl-screenrec -t "${__INSTALLATION_PREFIX}/bin/"

RUN cd wleave                \
    && cargo build --release \
    && install -s -Dm755 target/release/wleave -t "${__INSTALLATION_PREFIX}/bin/"

# -----------------------------------------------
# ----  Final Adjustments  ----------------------
# -----------------------------------------------

RUN __apt_install glycin-loaders                                             \
    && cp -r /usr/libexec/glycin-loaders "${__INSTALLATION_PREFIX}/libexec/" \
    && cp -r /usr/share/glycin-loaders   "${__INSTALLATION_PREFIX}/share/"   \
    && sed -i -E 's|/usr/(libexec/glycin-loaders)|/usr/local/\1|g' \
        "${__INSTALLATION_PREFIX}"/share/glycin-loaders/*/conf.d/*.conf

RUN cd "${__INSTALLATION_PREFIX}/lib/x86_64-linux-gnu" \
    && cp -r /lib/x86_64-linux-gnu/pulseaudio/ .       \
    && ln -s pulseaudio/libpulsecommon-17.0.so libpulsecommon-17.0.so

COPY commands/__finalize_runtime_libs /root/.local/bin/
RUN __finalize_runtime_libs

# ! CAUTION: 'libc' + 'ld-linux' MUST remain in sync
#   and MUST be the correct files from the correct place.
RUN cp --recursive \
  /usr/lib/x86_64-linux-gnu/libc.so.6            \
  /usr/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2 \
  /usr/lib/x86_64-linux-gnu/libdl.so.2           \
  /usr/lib/x86_64-linux-gnu/libpthread.so.0      \
  /usr/lib/x86_64-linux-gnu/libdisplay-info.so.3 \
  /usr/lib/x86_64-linux-gnu/spa-0.2              \
  /usr/lib/x86_64-linux-gnu/pipewire-0.3         \
  "${__INSTALLATION_PREFIX}/lib/x86_64-linux-gnu"
