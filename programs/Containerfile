# ----  Final Adjustments  ----------------------
# -----------------------------------------------

RUN __apt_install glycin-loaders                                             \
    && cp -r /usr/libexec/glycin-loaders "${__INSTALLATION_PREFIX}/libexec/" \
    && cp -r /usr/share/glycin-loaders   "${__INSTALLATION_PREFIX}/share/"   \
    && sed -i -E 's|/usr/(libexec/glycin-loaders)|/usr/local/\1|g' \
        "${__INSTALLATION_PREFIX}"/share/glycin-loaders/*/conf.d/*.conf

RUN cd "${__INSTALLATION_PREFIX}/lib/x86_64-linux-gnu" \
    && cp -r /lib/x86_64-linux-gnu/pulseaudio/ .       \
    && ln -s pulseaudio/libpulsecommon-17.0.so libpulsecommon-17.0.so \
    && ln -s gnome_disks/libgnome_disks.so libgnome_disks.so

COPY commands/__finalize_runtime_libs /root/.local/bin/
RUN __finalize_runtime_libs

# ! CAUTION: 'libc' + 'ld-linux' MUST remain in sync
#   and MUST be the correct files from the correct place.
RUN cp --recursive \
  /usr/lib/x86_64-linux-gnu/libc.so.6            \
  /usr/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2 \
  /usr/lib/x86_64-linux-gnu/libdl.so.2           \
  /usr/lib/x86_64-linux-gnu/libpthread.so.0      \
  /usr/lib/x86_64-linux-gnu/libdisplay-info.so.3 \
  /usr/lib/x86_64-linux-gnu/spa-0.2              \
  /usr/lib/x86_64-linux-gnu/pipewire-0.3         \
  "${__INSTALLATION_PREFIX}/lib/x86_64-linux-gnu"
