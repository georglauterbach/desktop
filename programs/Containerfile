        -D examples=false       \
        -D color-management=enabled


RUN git -C swayfx reset --hard || :
RUN __git_clone https://github.com/WillPower3309/swayfx.git \
    __commit_id 4d341dbb39952ae95f1d8be161359e9316cd6ab8
