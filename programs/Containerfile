# ? Associates

# * 0. Dependencies & cloning

RUN __apt_install libjpeg-dev libjxl-dev libadwaita-1-dev libgtk-4-dev valac

# The Evergruv patches replace whole source files of exactly this release.
# Only a patched stylesheet contains '#EBEBE4', so the build fails on stock.
RUN __git_clone --reset https://gitlab.gnome.org/GNOME/libadwaita.git 1.10.0
COPY patches/libadwaita/ /tmp/libadwaita/
RUN cp --recursive /tmp/libadwaita/. libadwaita/
RUN __apt_install sassc
RUN __build libadwaita meson_ninja                                         \
        -D documentation=false                                             \
        -D examples=false                                                  \
        -D introspection=enabled                                           \
        -D tests=false                                                     \
        -D vapi=false                                                      \
    && grep --quiet --ignore-case '#EBEBE4' libadwaita/build/src/stylesheet/gtk.css

# GTK4 apps without libadwaita need the same stylesheet as a theme directory.
# It requires GTK >= 4.23.1. Both variants share the one file behind
# `@media (prefers-color-scheme)`; `gtk-dark.css` is a hard link because
# `30-link.sh` only links regular files onto the host.
RUN mkdir --parents "${__INSTALLATION_PREFIX}/share/themes/Evergruv/gtk-4.0" \
    && cp --recursive                                                       \
        libadwaita/build/src/stylesheet/gtk.css                             \
        libadwaita/src/stylesheet/assets                                    \
        "${__INSTALLATION_PREFIX}/share/themes/Evergruv/gtk-4.0/"           \
    && cd "${__INSTALLATION_PREFIX}/share/themes/Evergruv/gtk-4.0"          \
    && ln gtk.css gtk-dark.css

RUN __git_clone https://github.com/wmww/gtk4-layer-shell.git \
    __commit_id 69ad9a02a8c31ac2d3db6710f43b3d8434559e46
RUN __build gtk4-layer-shell meson_ninja \
        -D examples=false                \
        -D docs=false                    \
        -D tests=false                   \
        -D smoke-tests=false             \
        -D introspection=true            \
        -D vapi=true

RUN __git_clone https://github.com/davatorium/rofi.git next
RUN __git_clone https://gitlab.freedesktop.org/emersion/grim.git master
RUN __git_clone https://github.com/emersion/slurp.git master
RUN __git_clone https://github.com/swaywm/swaybg.git master
RUN __git_clone https://github.com/swaywm/swayidle.git master
RUN __git_clone https://github.com/swaywm/swaylock.git master
RUN __git_clone https://github.com/kennylevinsen/wlsunset.git master
RUN __git_clone https://github.com/ErikReider/SwayNotificationCenter.git main
