# * 3. Custom builds

RUN cd alacritty                                                                     \
    && cargo build --release --no-default-features --features=wayland                \
    && install -s -Dm755 target/release/alacritty -t "${__INSTALLATION_PREFIX}/bin/" \
    && scdoc < extra/man/alacritty.1.scd                                             \
      | gzip -c >"${__INSTALLATION_PREFIX}/share/man/man1/alacritty.1.gz"            \
    && scdoc < extra/man/alacritty-msg.1.scd                                         \
      | gzip -c >"${__INSTALLATION_PREFIX}/share/man/man1/alacritty-msg.1.gz"        \
    && scdoc < extra/man/alacritty.5.scd                                             \
      | gzip -c >"${__INSTALLATION_PREFIX}/share/man/man5/alacritty.5.gz"            \
    && scdoc < extra/man/alacritty-bindings.5.scd                                    \
      | gzip -c >"${__INSTALLATION_PREFIX}/share/man/man5/alacritty-bindings.5.gz"

RUN __apt_install libluajit-5.1-dev
RUN cd ironbar               \
    && cargo build --release \
    && install -s -Dm755 target/release/ironbar -t "${__INSTALLATION_PREFIX}/bin/"

RUN cd awww \
    && cargo build --release \
    && install -s -Dm755 target/release/awww        -t "${__INSTALLATION_PREFIX}/bin/"   \
    && install -s -Dm755 target/release/awww-daemon -t "${__INSTALLATION_PREFIX}/bin/"   \
    && install    -Dm644 completions/awww.bash                                           \
        -t "${__INSTALLATION_PREFIX}/share/bash-completion/completions/"                 \
    && sh ./doc/gen.sh                                                                   \
    && for MAN_PAGE_FILE in doc/generated/*; do                                          \
        install -Dm644 "${MAN_PAGE_FILE}" -t "${__INSTALLATION_PREFIX}/share/man/man1/"; \
    done

RUN cd ianny \
    && cargo build --release \
    && install -s -Dm755 target/release/ianny -t "${__INSTALLATION_PREFIX}/bin/"

RUN cd lightctl \
    && cargo build --release \
    && install -s -Dm755 target/release/lightctl -t "${__INSTALLATION_PREFIX}/bin/"

RUN cd Satty                                                                                            \
    && cargo build --release                                                                            \
    && install -s -Dm755 target/release/satty -t "${__INSTALLATION_PREFIX}/bin/"                        \
    && install -Dm644 assets/satty.svg -t "${__INSTALLATION_PREFIX}/share/icons/hicolor/scalable/apps/" \
    && install -Dm644 satty.desktop    -t "${__INSTALLATION_PREFIX}/share/applications/"

RUN cd shikane                                                                        \
    && cargo build --release                                                          \
    && install -s -Dm755 target/release/shikane    -t "${__INSTALLATION_PREFIX}/bin/" \
    && install -s -Dm755 target/release/shikanectl -t "${__INSTALLATION_PREFIX}/bin/"

