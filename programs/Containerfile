COPY patches/swayfx_workspace_animation_output_hotplug.patch /tmp/
RUN git -C swayfx apply /tmp/swayfx_workspace_animation_output_hotplug.patch
RUN __build swayfx meson_ninja        \
        -D default-wallpaper=false    \
