#! /usr/bin/env bash

set -eE -u -o pipefail
shopt -s inherit_errexit

function copy_shared_objects_from_file() {
  OBJECT=${1:?A path to copy shared objects from is required}
  [[ -f ${OBJECT} ]] || return 0
  file "${OBJECT}" | grep --quiet 'dynamically linked' || return 0
  strip --strip-all "${OBJECT}"

  while read -r _ _ FILE _; do
    FILE=${FILE#/usr}
    [[ -e "${__INSTALLATION_PREFIX:?}${FILE}" ]] && continue

    mkdir --parents "${__INSTALLATION_PREFIX}/$(dirname "${FILE}")"

    if [[ -L ${FILE} ]]; then
      LINK_TARGET=$(realpath --canonicalize-existing --logical "${FILE}")
      LINK_TARGET_COPY=${__INSTALLATION_PREFIX}${LINK_TARGET#/usr}

      if [[ ! -e ${LINK_TARGET_COPY} ]]; then
        echo "Copying symbolic link target '${LINK_TARGET}' of '${FILE}'"
        mkdir --parents "$(dirname "${LINK_TARGET_COPY}")"
        cp "${LINK_TARGET}" "${LINK_TARGET_COPY}"
      fi

      echo "Linking '${__INSTALLATION_PREFIX}${FILE}' to '${LINK_TARGET_COPY}'"
      ln --symbolic --relative "${LINK_TARGET_COPY}" "${__INSTALLATION_PREFIX}${FILE}"
    else
      echo "Copying '${FILE}' to '${__INSTALLATION_PREFIX}${FILE}'"
      cp "${FILE}" "${__INSTALLATION_PREFIX}${FILE}"
    fi
  done < <(ldd "${OBJECT}" | grep -E ' /(usr/)?lib/')
}

for PROGRAM in "${__INSTALLATION_PREFIX}/bin/"* ; do
  copy_shared_objects_from_file "${PROGRAM}"
done

find /usr/local/libexec -executable | while read -r LIBEXEC_PROGRAM; do
  copy_shared_objects_from_file "${LIBEXEC_PROGRAM}"
done
