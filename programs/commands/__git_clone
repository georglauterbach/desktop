#! /usr/bin/env bash

set -eE -u -o pipefail
shopt -s inherit_errexit

function _log() {
  declare -r level=${1:?log level is required}
  shift 1
  __log "${level}" "git clone(${PROJECT_NAME}): ${*}"
}

function parse_arguments() {
  GIT_CLONE_CMD=(git clone --depth=1)
  GIT_RESET=false
  GIT_PINNED_TO=none

  if [[ ${1:-} == --reset ]]; then
    GIT_RESET=true
    shift 1
  fi

  GIT_CLONE_URI=${1:?git clone URI required}
  PROJECT_NAME=$(printf '%s' "${GIT_CLONE_URI}" | sed -E 's|.*/(.*)\.git$|\1|')

  if [[ ${2:?git revision is required} == __commit_id ]]; then
    GIT_REV=${3:?git revision is required}
    GIT_REV_LEN=$(printf '%s' "${GIT_REV}" | wc --chars)
    if [[ ${GIT_REV_LEN} -ne 40 ]] && [[ ${GIT_REV_LEN} -ne 64 ]]; then
      _log error "commit ID '${GIT_REV}' for '${PROJECT_NAME}' must be 40 (SHA1) or 60 (SHA256) characters long" >&2
      exit 1
    fi
    GIT_CLONE_CMD+=(--revision "${GIT_REV}")
    GIT_PINNED_TO=commit-id
    shift 3
  elif [[ ${2:?git revision is required} == __tag ]]; then
    GIT_REV=${3:?git tag is required}
    GIT_CLONE_CMD+=(--branch "${GIT_REV}")
    GIT_PINNED_TO=tag
    shift 3
  else
    GIT_REV=${2:?git revision is required}
    GIT_CLONE_CMD+=(--branch "${GIT_REV}")
    shift 2
  fi

  GIT_CLONE_CMD+=("${GIT_CLONE_URI}")

  readonly GIT_CLONE_CMD GIT_RESET GIT_PINNED_TO GIT_CLONE_URI PROJECT_NAME
}

function main() {
  parse_arguments "${@}"

  if [[ ! -e ${PROJECT_NAME} ]]; then
    _log info "cloning @ ${GIT_REV}"
    "${GIT_CLONE_CMD[@]}"
    exit 0
  fi

  _log info 'project directory exist, revision check pending'

  if [[ ${GIT_RESET} == true ]]; then
    _log info 'resetting changes'
    git -C "${PROJECT_NAME}" reset --hard
  fi

  if ! git -C "${PROJECT_NAME}" checkout "${GIT_REV}" &>/dev/null; then
    _log info "revision check failed, removing and cloning again"
    rm --recursive --force "${PROJECT_NAME}"
    "${GIT_CLONE_CMD[@]}"
    exit 0
  fi

  if [[ ${GIT_PINNED_TO} == commit-id ]]; then
    _log info "project is pinned to commit '${GIT_REV}', not pulling"
  elif [[ ${GIT_PINNED_TO} == tag ]]; then
    _log info "project is pinned to tag '${GIT_REV}', not pulling"
  else
    __log info "project is not pinned (revision is '${GIT_REV}'), pulling"
    git -C "${PROJECT_NAME}" pull
  fi
}

main "${@}"
