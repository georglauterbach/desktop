#! /usr/bin/env bash

set -eE -u -o pipefail
shopt -s inherit_errexit

function meson_ninja() {
  __log info "build(${BUILD_DIR}): configuring project"
  meson setup build     \
    --reconfigure       \
    --backend=ninja     \
    --clearcache        \
    --buildtype=release \
    --optimization=3    \
    --strip             \
    --warnlevel=0       \
    --prefix="${__INSTALLATION_PREFIX:?}" "${@}"

  __log info "build(${BUILD_DIR}): building and installing project"
  ninja -C build install
}

readonly BUILD_DIR=${1:?Directory to build in is required}

( cd "${BUILD_DIR}" ; shift 1 ; "${@}" ; )
