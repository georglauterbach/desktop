#! /usr/bin/env bash

set -eE -u -o pipefail
shopt -s inherit_errexit

function meson_ninja() {
  # cSpell: ignore buildtype warnlevel
  meson setup build     \
    --reconfigure       \
    --backend=ninja     \
    --clearcache        \
    --buildtype=release \
    --optimization=3    \
    --strip             \
    --warnlevel=0       \
    --prefix="${__INSTALLATION_PREFIX:?}" "${@}"

  ninja -C build install
}

__log "Building '${1:?Directory to build in is required}'"
( cd "${1}" ; shift 1 ; "${@}" ; )
