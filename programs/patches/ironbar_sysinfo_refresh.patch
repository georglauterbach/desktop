+/// Every module instance (one per config entry and bar) refreshes this shared
+/// client on its own timer. CPU usage and disk/network rates are deltas since
+/// the previous refresh, so refreshes closer together than this are skipped;
+/// modules showing the same kind of data must use the same interval for it.
+const MIN_DELTA_REFRESH_INTERVAL: Duration = Duration::from_secs(1);
+
+/// Returns whether a delta-based refresh is due and, if so, records it.
+fn delta_refresh_due(last_refresh: &Mutex<Instant>) -> bool {
+    let mut last_refresh = lock!(last_refresh);
+    let due = last_refresh.elapsed() >= MIN_DELTA_REFRESH_INTERVAL;
+    if due {
+        *last_refresh = Instant::now();
+    }
+    due
+}
