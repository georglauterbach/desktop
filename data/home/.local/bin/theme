#! /usr/bin/env bash

# shellcheck disable=SC2329

set -eE -u -o pipefail
shopt -s inherit_errexit

function log_debug() {
  echo -e "$(date --iso-8601=s) \033[1;36mDEBUG\033[0m ${1:?Log info message required}"
}

function log_info() {
  echo -e "$(date --iso-8601=s)  \033[1;34mINFO\033[0m ${1:?Log info message required}"
}

function log_warn() {
  echo -e "$(date --iso-8601=s)  \033[1;33mWARN\033[0m ${1:?Log warning message required}" >&2
}

function log_error() {
  echo -e "$(date --iso-8601=s) \033[1;31mERROR\033[0m ${1:?Log warning message required}" >&2
}

function set_theme_alacritty() {
  local CONFIG_DIR=${XDG_CONFIG_HOME}/alacritty
  local CONFIG_FILE=themes/evergruv_${THEME_VARIANT}.toml

  if [[ ! -d ${CONFIG_DIR} ]] || [[ ! -s ${CONFIG_DIR}/${CONFIG_FILE} ]]; then
    return 2
  fi

  ln --symbolic --force "${CONFIG_FILE}" "${CONFIG_DIR}/theme-active.toml" || return 1
}

function set_theme_flatpak() {
  if [[ -s ${HOME}/.local/share/flatpak/overrides/global ]]; then
    # GTK_THEME would bypass the portal, which already hands sandboxed apps the
    # theme name and color scheme the host uses; drop it from older overrides.
    sed --in-place --regexp-extended               \
      -e "s|~|${HOME}|g"                           \
      -e '/^GTK_THEME=/d'                          \
      -e "s|(ICON_THEME=).*|\1${ICON_THEME_NAME}|" \
      "${HOME}"/.local/share/flatpak/overrides/global

    # The sandbox's XDG_CONFIG_HOME is per app, so GTK only finds the `gtk.css`
    # that recolors libadwaita once the host's directory is shared with it.
    flatpak override --user --filesystem=xdg-config/gtk-4.0:ro \
      || { log_warn 'Could not share the GTK4 configuration with Flatpak apps' ; return 1 ; }
  fi
}

function set_theme_gtk() {
  mkdir --parents "${HOME}"/.{local/share/{themes,icons},config/gtk-{3,4}.0}

  # Flatpak redirects XDG_DATA_HOME to `~/.var/app/<id>/data`, so sandboxed GTK
  # never searches `~/.local/share/themes`. It does search `$HOME/.themes`,
  # because HOME stays untouched - hence the symlink rather than a second copy.
  # `--no-target-directory` keeps a leftover real `~/.themes` from swallowing
  # the link instead of being reported.
  if ! ln --symbolic --force --no-target-directory .local/share/themes "${HOME}/.themes"; then
    log_warn "Could not link '${HOME}/.themes' - remove it if it is a real directory"
    return 1
  fi

  local gtk_version gtk_version_theme_name
  for gtk_version in {3..4}; do
    # libadwaita is GTK4 only, so naming the Evergruv build to GTK3 would only
    # send GTK3 apps looking for a directory that holds a GTK4 stylesheet.
    if [[ ${gtk_version} -eq 3 ]]; then
      gtk_version_theme_name=${GTK3_THEME_NAME}
    else
      gtk_version_theme_name=${GTK4_THEME_NAME}
    fi

    if [[ -s ${HOME}/.config/gtk-${gtk_version}.0/settings.ini ]]; then
      if ! sed --in-place --regexp-extended \
        -e "s|^(gtk-theme-name=).*|\1${gtk_version_theme_name}|" \
        -e "s|^(gtk-icon-theme-name=).*|\1${ICON_THEME_NAME}|" \
        -e "s|^(gtk-cursor-theme-name=).*|\1${CURSOR_THEME_NAME}|" \
        "${HOME}/.config/gtk-${gtk_version}.0/settings.ini"
      then
        log_warn "Failed to update GTK ${gtk_version} theme settings"
        return 1
      fi
    fi
  done

  gsettings set org.gnome.desktop.interface gtk-theme "${GTK4_THEME_NAME}" \
    || { log_warn 'Could not set GTK theme' ; return 1 ; }
  gsettings set org.gnome.desktop.interface icon-theme "${ICON_THEME_NAME}" \
    || { log_warn 'Could not set GTK icon theme' ; return 1 ; }
  gsettings set org.gnome.desktop.interface cursor-theme "${CURSOR_THEME_NAME}" \
    || { log_warn 'Could not set cursor theme' ; return 1 ; }
  gsettings set org.gnome.desktop.interface color-scheme "prefer-${THEME_VARIANT}" \
    || { log_warn 'Could not set GTK color scheme preference' ; return 1 ; }

  if "${FORCE}"; then
    rm --force --recursive "${HOME}/.cache/"gtk-{3,4}.0 \
      || { log_warn "Could not delete GTK cache" ; return 1 ; }
    gtk-update-icon-cache --force 2>/dev/null || :
  fi

  gsettings set org.gnome.desktop.interface font-name           'Ubuntu Sans 12'
  gsettings set org.gnome.desktop.interface document-font-name  'Ubuntu Sans 12'
  gsettings set org.gnome.desktop.interface monospace-font-name 'JetBrainsMono Nerd Font 11'

  rm --force "${HOME}/.config/gtk-4.0/colors.css"
}

function set_theme_rofi() {
  # cSpell: ignore rasi
  local CONFIG_FILE=${XDG_CONFIG_HOME}/rofi/config.rasi

  [[ -s ${CONFIG_FILE} ]] || return 2
  sed --in-place --regexp-extended \
    "s|(theme )\".*\"|\1\"themes/evergruv_${THEME_VARIANT}\"|" \
    "${CONFIG_FILE}"
}

function set_theme_shell() {
  bash -l -i -c \
    "[[ \$(type -t hermes::switch_theme) != function ]] || hermes::switch_theme ${THEME_VARIANT}"

  local __HERMES__SHELLS_TO_UPDATE=${XDG_RUNTIME_DIR:-/tmp}/hermes-${UID}/shells
  [[ -r ${__HERMES__SHELLS_TO_UPDATE} ]] || return 0

  # We ignore SC2094 because we fully read the file first,
  # and then we overwrite it afterward.
  # shellcheck disable=SC2094
  {
    flock -s -w 2 3 || return 1
    while read -r PID; do
      if ps --pid "${PID}" &>/dev/null; then
        kill -s SIGUSR2 "${PID}" || return 1
        echo "${PID}" >>"${__HERMES__SHELLS_TO_UPDATE}.exit"
      fi
    done <&3

    if [[ -s "${__HERMES__SHELLS_TO_UPDATE}.exit" ]]; then
      # shellcheck disable=SC2217
      mv --force "${__HERMES__SHELLS_TO_UPDATE}.exit" "${__HERMES__SHELLS_TO_UPDATE}" < /dev/null
    fi
  } 3< "${__HERMES__SHELLS_TO_UPDATE}"
}

function set_theme_sway() {
  # shellcheck disable=SC2016
  declare -ar filler=('$color.transparent' '$color.transparent' '$color.transparent')

  swaymsg client.focused "${filler[@]}" \
    "\$color.${THEME_VARIANT}.foreground" "\$color.${THEME_VARIANT}.foreground" \
    || return 1
  swaymsg client.focused_inactive "${filler[@]}" \
    "\$color.${THEME_VARIANT}.foregroundB0" "\$color.${THEME_VARIANT}.foregroundB0" \
    || return 1
  swaymsg client.unfocused "${filler[@]}" \
    "\$color.${THEME_VARIANT}.foregroundB0" "\$color.${THEME_VARIANT}.foregroundB0" \
    || return 1
  swaymsg client.urgent "${filler[@]}" \
    "\$color.${THEME_VARIANT}.red" "\$color.${THEME_VARIANT}.red" \
    || return 1
}

function set_theme_swaylock() {
  local CONFIG_DIR=${XDG_CONFIG_HOME}/swaylock
  local CONFIG_FILE=themes/evergruv_${THEME_VARIANT}

  if [[ ! -d ${CONFIG_DIR} ]] || [[ ! -s ${CONFIG_DIR}/${CONFIG_FILE} ]]; then
    return 2
  fi

  ln --symbolic --force "${CONFIG_FILE}" "${CONFIG_DIR}/config"
}

function set_theme_swaync() {
  local CONFIG_DIR=${XDG_CONFIG_HOME}/swaync
  local CONFIG_FILE=themes/evergruv_${THEME_VARIANT}.css

  if [[ ! -d ${CONFIG_DIR} ]] || [[ ! -s ${CONFIG_DIR}/${CONFIG_FILE} ]]; then
    return 2
  fi

  ln --symbolic --force "${CONFIG_FILE}" "${CONFIG_DIR}/style.css" || return 1

  if ! pgrep -x swaync >/dev/null; then
    log_debug 'SwayNC is not running, not restarting it'
    return 2
  fi

  timeout 2 swaync-client --skip-wait --reload-css >/dev/null
}

function set_theme_wallpaper() {
  local CONFIG_DIR=${XDG_CONFIG_HOME}/sway/theme
  local CONFIG_FILE=${THEME_VARIANT}/wallpaper.svg

  if [[ ! -d ${CONFIG_DIR} ]] || [[ ! -s ${CONFIG_DIR}/${CONFIG_FILE} ]]; then
    return 2
  fi

  ln --symbolic --force "${CONFIG_FILE}" "${CONFIG_DIR}/wallpaper" || return 1
  awww img "${CONFIG_DIR}/wallpaper" --transition-type fade --transition-duration 0.4
}

function set_theme_wleave() {
  local CONFIG_DIR=${XDG_CONFIG_HOME}/wleave
  local CONFIG_FILE=themes/evergruv_${THEME_VARIANT}.css

  if [[ ! -d ${CONFIG_DIR} ]] || [[ ! -s ${CONFIG_DIR}/${CONFIG_FILE} ]]; then
    return 2
  fi

  ln --symbolic --force "${CONFIG_FILE}" "${CONFIG_DIR}/style.css"
}

function set_theme_x11() {
  # cSpell: disable xsettingsd
  if [[ -s ${HOME}/.config/xsettingsd/xsettingsd.conf ]]; then
    # X11 clients here are GTK3, which the Evergruv build does not cover.
    sed --in-place --regexp-extended \
      -e "s|^(Net/ThemeName).*|\1 \"${GTK3_THEME_NAME}\"|" \
      -e "s|^(Net/IconThemeName).*|\1 \"${ICON_THEME_NAME}\"|" \
      "${HOME}/.config/xsettingsd/xsettingsd.conf"
  fi
}

function run_update_async() {
  local UPDATE_COMPONENT=${1:?Update message required}
  local UPDATE_FUNCTION=${2:?Update function name required}
  shift 2

  ${UPDATE_FUNCTION} "${@}" &
  job_name_mapping[${!}]=${UPDATE_COMPONENT}
}

function main() {
  export XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-${HOME}/.config}
  local FORCE=false GTK3_THEME_NAME=Adwaita GTK4_THEME_NAME=Evergruv ICON_THEME_NAME=Evergruv THEME_VARIANT=light

  while [[ ${#} -gt 0 ]]; do
    case "${1:-}" in
      ( l | light ) ;;

      ( d | dark )
        THEME_VARIANT=dark
        GTK3_THEME_NAME+=-${THEME_VARIANT}
        ICON_THEME_NAME+=-${THEME_VARIANT}
        ;;

      ( -f | --force )
        FORCE=true
        log_info 'Forcing update'
        ;;

      ( * )
        echo -e "\033[1;31mERROR\033[0m Argument '${1:-}' is invalid - use 'light|l' or 'dark|d' or '-f|--force'" >&2
        exit 1
        ;;
    esac
    shift 1
  done

  # The Evergruv icon themes only recolor Adwaita's folders (see
  # `data/theme/patch_adwaita_icons.sh`) and ship no cursors.
  readonly CURSOR_THEME_NAME=Adwaita

  readonly THEME_VARIANT ICON_THEME_NAME GTK4_THEME_NAME GTK3_THEME_NAME FORCE
  log_info "Updating theme to \033[1m${THEME_VARIANT^}\033[0m"

  local job_id job_result job_name exit_code=0
  declare -A job_name_mapping=()

  run_update_async shell                  set_theme_shell
  run_update_async Alacritty              set_theme_alacritty
  run_update_async Flatpak                set_theme_flatpak
  run_update_async GTK                    set_theme_gtk
  run_update_async Rofi                   set_theme_rofi
  run_update_async Sway                   set_theme_sway
  run_update_async Swaylock               set_theme_swaylock
  run_update_async SwayNotificationCenter set_theme_swaync
  run_update_async wallpaper              set_theme_wallpaper
  run_update_async Wleave                 set_theme_wleave
  run_update_async X11                    set_theme_x11

  while [[ -n $(jobs -p || :) ]]; do
    job_result=0
    wait -n -p job_id || job_result=${?}
    job_name=${job_name_mapping[${job_id}]}

    case "${job_result:-0}" in
      ( 0 )
        log_info "Updated ${job_name}"
        ;;

      ( 1 )
        log_warn "Update of ${job_name} failed"
        exit_code=1
        ;;

      ( 2 )
        log_debug "No update of ${job_name} performed"
        ;;

      ( * )
        log_warn "Unknown error occurred during update of ${job_name}"
        exit_code=1
        ;;
    esac
  done

  exit "${exit_code}"
}

main "${@}"
