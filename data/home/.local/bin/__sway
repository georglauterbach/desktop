#! /usr/bin/env bash

set +eE -u -o pipefail
shopt -s inherit_errexit

mkdir -p /tmp/.sway/
rm -f    /tmp/.sway/sway.log   /tmp/.sway/sway.err.log
exec    >/tmp/.sway/sway.log 2>/tmp/.sway/sway.err.log

echo 'INFO  Setting up environment for Sway'

export WLR_RENDERER=vulkan

export XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-${HOME}/.config}
export XDG_CACHE_HOME=${XDG_CACHE_HOME:-${HOME}/.cache}
export XDG_DATA_HOME=${XDG_DATA_HOME:-${HOME}/.local/share}
export XDG_STATE_HOME=${XDG_STATE_HOME:-${HOME}/.local/state}

export XDG_CURRENT_DESKTOP=sway
systemctl --user set-environment "XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP}"

unset DISPLAY WAYLAND_DISPLAY
systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY

if [[ -v XDG_RUNTIME_DIR ]]; then
  export SSH_AUTH_SOCK=${XDG_RUNTIME_DIR}/ssh-agent.socket
else
  echo "WARN  Environment variable 'XDG_RUNTIME_DIR' not set" >&2
fi

# PAM already started an unlocked --login daemon. --start finishes its init
# (secrets) on that same process so a later D-Bus activation cannot replace
# it with a locked Secret Service. Unlock stays PAM's job. We skip SSH here
# because we run a dedicated systemd user service ssh agent.
if command -v gnome-keyring-daemon &>/dev/null; then
  # shellcheck source=/dev/null
  gnome-keyring-daemon --start --components=secrets,pkcs11 2>/dev/null || :
fi

echo 'INFO  Executing Sway now'
exec sway
