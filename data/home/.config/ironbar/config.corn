// ----------------------------------------------
// ----  Ironbar Configuration  -----------------
// ----  https://github.com/JakeStanger/ironbar  -
// ----------------------------------------------
//
// cSpell: ignore prefsrc waybar
//
// ref: https://github.com/JakeStanger/ironbar/wiki
//      https://www.nerdfonts.com/cheat-sheet
//      `ironbar --print-schema`

let {
  // -------------------------------------------
  // ----  Start Modules  ----------------------
  // -------------------------------------------

  $tray = { type = "tray" icon_size = 13 }

  $inhibit = {
    type = "inhibit"
    durations = [ "03:00:00" ]
    format_on = " "
    format_off = " "
    tooltip = "idle inhibitor"
  }

  $notifications = {
    type = "notifications"
    show_count = true
    icons.closed_none = " "
    icons.closed_some = " "
    icons.closed_dnd = " "
    icons.open_none = " "
    icons.open_some = " "
    icons.open_dnd = " "
    on_click_right = "swaync-client --toggle-dnd --skip-wait"
  }

  $focused = {
    type = "focused"
    show_icon = false
    truncate.mode = "end"
    truncate.max_length = 90
  }

  $bindmode = { type = "bindmode" }

  // -------------------------------------------
  // ----  Center Modules  ---------------------
  // -------------------------------------------

  // Waybar dropped the `N:` prefix of the names in `sway/config`; Ironbar
  // focuses by number, so the prefix must stay and is mapped away here.
  $workspaces = {
    type = "workspaces"
    sort = "index"
    name_map.'1:01 ' = "01 "
    name_map.'2:02 󰨞' = "02 󰨞"
    name_map.'3:03 ' = "03 "
    name_map.'4:04 󰇮' = "04 󰇮"
    name_map.'5:05 ' = "05 "
    name_map.'6:06 ' = "06 "
    name_map.'7:07 ' = "07 "
    name_map.'8:08 ' = "08 "
    name_map.'9:09 ' = "09 "
    name_map.'10:10 󰊻' = "10 󰊻"
    name_map.'11:11 ' = "11 "
    name_map.'12:12 ' = "12 "
    name_map.'13:13 ' = "13 "
    name_map.'14:14 ' = "14 "
    name_map.'15:15 ' = "15 "
    name_map.'16:16 ' = "16 "
    name_map.'17:17 ' = "17 "
    name_map.'18:18 ' = "18 "
    name_map.'19:19 ' = "19 "
  }

  // -------------------------------------------
  // ----  End Modules  ------------------------
  // -------------------------------------------

  // `gpu-usage-waybar` prints Waybar-specific JSON; it needs a plain-text
  // output before it can be used with a `script` module.
  // $gpu = { type = "script" cmd = "watch:gpu-usage-waybar --interval 5000" }

  $cpu = {
    type = "sys_info"
    name = "cpu"
    format = [ " {cpu_percent: <3}%" ]
    interval.cpu = 5
  }

  $memory = {
    type = "sys_info"
    name = "memory"
    format = [ " {memory_used#Gi: <4.1}Gi" ]
    interval.memory = 10
  }

  // ponytail: fixed kB/s; Ironbar cannot auto-scale units like Waybar;
  // `max` approximates the default-route adapter (a sum counts tunnels twice)
  $network = {
    type = "sys_info"
    name = "network"
    format = [ "󰌘 {net_down@max#k: <5.1}kB/s  |{net_up@max#k: <5.1}kB/s " ]
    interval.networks = 5
    tooltip = "{{5000:ip -json -4 route get 1.1.1.1 | jq -r '.[0] | \"󰩟 \" + .prefsrc + \"@\" + .dev + \" via \" + (.gateway // \"-\")'}}"
  }

  // `{percentage}` cannot be padded, so the icons carry trailing spaces that
  // keep the label three digits wide; mute formats are as wide as `100%`.
  // Profile icons fall back to Ironbar's defaults, not to `icons` above.
  $volume_sink = {
    type = "volume"
    name = "volume-sink"
    show_sources = false
    format = "{icon} {percentage}%"
    mute_format = "󰝟 HUSH"
    icons.volume = ""
    use_default_profiles = false
    profiles.single_digit = { when = 9 icons.volume = "  " }
    profiles.low = { when = 33.33 icons.volume = " " }
    profiles.medium = { when = 66.66 icons.volume = " " }
    profiles.high = { when = 99 icons.volume = " " }
    scroll_step = 5
    max_volume = 100
    on_click_middle = "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  }

  $volume_source = {
    type = "volume"
    name = "volume-source"
    show_sinks = false
    format = "{icon} {percentage}%"
    mute_format = "{icon} MUTE"
    icons.mic_volume = "󰍬"
    icons.mic_muted = "󰍭"
    use_default_profiles = false
    profiles.single_digit = { when = 9 icons.mic_volume = "󰍬  " icons.mic_muted = "󰍭" }
    profiles.double_digit = { when = 99 icons.mic_volume = "󰍬 " icons.mic_muted = "󰍭" }
    scroll_step = 5
    on_click_middle = "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
  }

  // The first profile (by ascending `percent`) that matches wins; the
  // discharging ones need `charging = false` so they don't hide `charging`.
  $battery = {
    type = "battery"
    show_if = "test -d /sys/class/power_supply/BAT0"
    show_icon = false
    format = "󰁹 {percentage}%"
    profiles.critical = { when = { percent = 10 charging = false } format = "󰂃 {percentage}%" }
    profiles.low = { when = { percent = 25 charging = false } format = "󰁻 {percentage}%" }
    profiles.medium = { when = { percent = 50 charging = false } format = "󰁾 {percentage}%" }
    profiles.high = { when = { percent = 90 charging = false } format = "󰂁 {percentage}%" }
    profiles.charging = { when = { percent = 100 charging = true } format = "󰂄 {percentage}%" }
  }

  $clock = {
    type = "clock"
    format = "󱑂 %H:%M"
    locale = "de_DE"
    show_week_numbers = true
  }
} in {
  // -------------------------------------------
  // ----  General  ----------------------------
  // -------------------------------------------

  position = "top"
  layer = "top"
  anchor_to_edges = true
  height = 24

  start = [ $tray $inhibit $notifications $focused $bindmode ]
  center = [ $workspaces ]
  end = [ $cpu $memory $battery $volume_sink $volume_source $clock ]
}
