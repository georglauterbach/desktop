// > https://github.com/davatorium/rofi/blob/next/doc/rofi-theme.5.markdown

configuration {
    show: "combi";
    modes: [combi,drun];
    combi-modes: [window,drun];

    click-to-exit: false;

    show-icons: false;
    font: "JetBrainsMono Nerd Font 12";

    display-ssh:         "󰣀 ";
    display-run:         " ";
    display-drun:        "󱓞 ";
    display-window:      "󱂬 ";
    display-combi:       "󰕘 ";
    display-filebrowser: "󰉋 ";
}

@theme "themes/evergruv_dark"

entry {
  hide-cursor-on-empty: true;
}
