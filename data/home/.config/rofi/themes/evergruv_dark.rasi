* {

    color-bg:        #1D2021;
    color-bg-dim:    #141617;
    color-bg-dim-tp: #141617A0;

    color-bd-act:    #4D4A45;

    color-fg:        #DDC7A1;

    color-red:       #EA6962;
    color-orange:    #E78A4E;
    color-yellow:    #D8A657;
    color-green:     #A9B665;
    color-cyan:      #89B482;
    color-blue:      #7DAEA3;
    color-purple:    #D3869B;

    color-accent: @color-yellow;
}

@import "evergruv"
