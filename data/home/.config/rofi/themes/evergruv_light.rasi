* {
    color-bg:        #F5F5F2;
    color-bg-dim:    #EBEBE4;
    color-bg-dim-tp: #EBEBE4C0;

    color-bd-act:    #A4A9AC;

    color-fg:        #505D65;

    color-red:       #F85552;
    color-orange:    #F57D26;
    color-yellow:    #D69A00;
    color-green:     #8DA101;
    color-cyan:      #35A77C;
    color-blue:      #3A94C5;
