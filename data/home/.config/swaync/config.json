{
  "$schema": "/usr/local/etc/xdg/swaync/configSchema.json",
  "layer": "overlay",
  "control-center-layer": "overlay",
  "layer-shell": true,
  "layer-shell-cover-screen": false,
  "positionX": "right",
  "positionY": "bottom",
  "control-center-positionX": "right",
  "control-center-positionY": "top",
  "notification-grouping": true,
  "transition-time": 250,
  "fit-to-screen": false,
  "control-center-width": 620,
  "control-center-height": 900,
  "control-center-margin-top": 25,
  "control-center-margin-right": 25,
  "notification-window-width": 620,
  "keyboard-shortcuts": true,
  "widgets": [
    "title",
    "dnd",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "notifications": {}
  }
}
