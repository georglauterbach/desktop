# ref: https://wiki.archlinux.org/title/Systemd/User
#      https://www.freedesktop.org/software/systemd/man/latest/systemd.service.html

[Unit]
Description=Wayland PipeWire Idle Inhibit | Inhibit Idling When Media Is Played Through PipeWire
Wants=pipewire.service
After=pipewire.service graphical-session.target
PartOf=graphical-session.target
Requisite=graphical-session.target
Documentation=https://github.com/rafaelrc7/wayland-pipewire-idle-inhibit

[Service]
Type=simple
ExecStart=/usr/local/bin/wayland-pipewire-idle-inhibit
StandardOutput=journal

Restart=on-failure
RestartSec=3

[Install]
WantedBy=sway-session.target
